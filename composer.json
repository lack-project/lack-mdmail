{
    "name": "lack-project/lack-mdmail",
    "description": "A markdown mailer using PHPMailer",
    "type": "library",
    "license": "MIT",
    "keywords": ["markdown", "mailer", "phpmailer", "email", "html"],
    "authors": [
        {
            "name": "lack-project"
        }
    ],
    "require": {
        "php": ">=7.4",
        "phpmailer/phpmailer": "^6.8",
        "league/commonmark": "^2.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "LackProject\\MdMail\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LackProject\\MdMail\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}